<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101321</item>
        <item name="android:navigationBarColor">#101321</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#30D85C</item>
        <item name="android:windowBackground">#101321</item>
    </style>
    <style name="PillButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/pill_light</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#F5F5FA</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="WidgetPill">
        <item name="android:background">@drawable/pill_dark</item>
        <item name="android:textColor">#101321</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
    </style>
    <style name="ModeLabel">
        <item name="android:textColor">#F5F5FA</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="BatteryLabel">
        <item name="android:textColor">#AEB3C9</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
